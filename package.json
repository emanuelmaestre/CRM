{
  "name": "crm-leo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:phase-c": "playwright test e2e/metricas.spec.ts",
    "test:e2e:phase-b": "playwright test e2e/importacao-previa.spec.ts e2e/pedidos-consulta.spec.ts e2e/automacoes-historico.spec.ts",
    "test:e2e:phase-a": "playwright test e2e/navegacao-responsiva.spec.ts e2e/auth-perfis.spec.ts e2e/core-crm.spec.ts e2e/operacao-comercial.spec.ts",
    "test:e2e:staging": "node scripts/verify-staging-e2e.mjs",
    "test:rls": "node scripts/test-rls.mjs",
    "test:phase-b:integration": "node scripts/test-phase-b-integration.mjs",
    "test:phase-b:gates": "vitest run --config vitest.integration.config.mts",
    "test:integration": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.mts",
    "test:phase-b:production": "node scripts/verify-phase-b-production.mjs",
    "test:phase-c:gates": "vitest run src/test/domain/scoring.test.ts src/test/domain/guardrails-ia.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:ci:bootstrap": "node scripts/setup-ci-database.mjs bootstrap",
    "db:ci:grants": "node scripts/setup-ci-database.mjs grants",
    "db:seed:synthetic": "node scripts/seed-synthetic.mjs",
    "db:ci:seed-e2e": "node scripts/seed-ci-e2e.mjs",
    "test:seed-synthetic": "node scripts/test-seed-synthetic.mjs",
    "db:migrate": "node scripts/migrar.mjs",
    "db:studio": "drizzle-kit studio",
    "estoque:coletar": "node --env-file=.env.local --import tsx scripts/coletar-estoque.mts",
    "shopee:buscar": "node --env-file=.env --env-file=.env.local --import tsx scripts/buscar-anuncio-shopee.mts",
    "anuncios:shopee:inspecionar": "node --env-file=.env.local --import tsx scripts/inspecionar-anuncios-shopee.mts"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.110.8",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.1.1",
    "inngest": "^4.18.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^9.3.10",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.0",
    "dompurify": "^3.4.13",
    "glob": {
      "brace-expansion": "^2.1.4"
    }
  }
}
