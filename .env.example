# Supabase / Postgres
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
PROVISION_SECRET=use-a-long-random-secret
DATABASE_URL=postgresql://user:password@host:5432/database

# Organização e marcas
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000000
# Opcional: tenant exclusivo para seeds sintéticos; nunca use o DEFAULT_ORG_ID em banco remoto.
SYNTHETIC_SEED_ORG_ID=00000000-0000-4000-8000-000000000001
BRAND_ID_KARZI=00000000-0000-0000-0000-000000000001
BRAND_ID_WUWU=00000000-0000-0000-0000-000000000002
BRAND_ID_ARMARINHOS_LIMA=00000000-0000-0000-0000-000000000003
NEXT_PUBLIC_BRAND_ID_KARZI=00000000-0000-0000-0000-000000000001
NEXT_PUBLIC_BRAND_ID_WUWU=00000000-0000-0000-0000-000000000002
NEXT_PUBLIC_BRAND_ID_ARMARINHOS_LIMA=00000000-0000-0000-0000-000000000003

# OpenAI
OPENAI_API_KEY=your-openai-key

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Inngest
INNGEST_SIGNING_KEY=your-inngest-signing-key
INNGEST_EVENT_KEY=your-inngest-event-key

# Kill switch: mantenha false até concluir os gates de go-live
EXTERNAL_SENDS_ENABLED=false

# Marketplaces
ML_CLIENT_ID=your-ml-client-id
# ML_CLIENT_SECRET tem dupla função: (1) troca de code/refresh_token no OAuth e
# (2) chave usada pelo Mercado Livre para assinar as notificações de webhook
# (header x-signature em src/app/api/webhooks/mercadolivre/route.ts) — é o
# mesmo segredo usado nos dois casos, não há um ML_WEBHOOK_SECRET separado.
ML_CLIENT_SECRET=your-ml-client-secret
ML_SELLER_ID_KARZI=your-ml-seller-id-karzi
ML_SELLER_ID_WUWU=your-ml-seller-id-wuwu
ML_SELLER_ID_ARMARINHOS_LIMA=your-ml-seller-id-armarinhos-lima
# Fallback estático: só é lido quando não existe token persistido em
# canal_tokens para a marca (bootstrap/emergência). Não é atualizado pelo job
# de refresh automático (A23-refresh-ml-tokens) — prefira conectar via OAuth.
ML_ACCESS_TOKEN_KARZI=your-ml-access-token-karzi
ML_ACCESS_TOKEN_WUWU=your-ml-access-token-wuwu
ML_ACCESS_TOKEN_ARMARINHOS_LIMA=your-ml-access-token-armarinhos-lima
ML_REFRESH_TOKEN_KARZI=your-ml-refresh-token-karzi
ML_REFRESH_TOKEN_WUWU=your-ml-refresh-token-wuwu
ML_REFRESH_TOKEN_ARMARINHOS_LIMA=your-ml-refresh-token-armarinhos-lima
# SHOPEE_ENV troca qual par de credenciais abaixo é usado (auth_partner,
# auth/token/get e todo o resto das chamadas assinadas via shopee.provider.ts).
# "test" usa o app de sandbox (partner.test-stable.shopeemobile.com);
# qualquer outro valor, ou a variável ausente, usa produção — mesmo default
# de sempre. Partner_id/Partner_key são do APP (Open Platform), não da loja
# — um só par vale pra todas as marcas; shop_id/access_token abaixo é que
# são por marca.
SHOPEE_ENV=test
SHOPEE_PARTNER_ID_TEST=your-shopee-test-partner-id
SHOPEE_PARTNER_KEY_TEST=your-shopee-test-partner-key
SHOPEE_PARTNER_ID_LIVE=your-shopee-live-partner-id
SHOPEE_PARTNER_KEY_LIVE=your-shopee-live-partner-key
# São TRÊS apps no Open Platform, um por categoria de API, cada um com seu par
# próprio: o de cima é o "Elisa Lima CRM" (Product Management — catálogo,
# estoque, avaliações), e os dois abaixo são "Elisa Lima Pedidos" (Order
# Management) e "Elisa Lima Anuncios" (Ads Service — Product Ads). O par não é
# intercambiável: a Shopee valida a assinatura HMAC contra o partner_key do app
# dono do partner_id. Cada app também tem sua PRÓPRIA autorização OAuth por
# loja — conectar um não conecta nem desconecta os outros.
SHOPEE_PARTNER_ID_PEDIDOS_TEST=your-shopee-test-partner-id-pedidos
SHOPEE_PARTNER_KEY_PEDIDOS_TEST=your-shopee-test-partner-key-pedidos
SHOPEE_PARTNER_ID_PEDIDOS_LIVE=your-shopee-live-partner-id-pedidos
SHOPEE_PARTNER_KEY_PEDIDOS_LIVE=your-shopee-live-partner-key-pedidos
SHOPEE_PARTNER_ID_ANUNCIOS_TEST=your-shopee-test-partner-id-anuncios
SHOPEE_PARTNER_KEY_ANUNCIOS_TEST=your-shopee-test-partner-key-anuncios
SHOPEE_PARTNER_ID_ANUNCIOS_LIVE=your-shopee-live-partner-id-anuncios
SHOPEE_PARTNER_KEY_ANUNCIOS_LIVE=your-shopee-live-partner-key-anuncios
SHOPEE_SHOP_ID_KARZI=your-shopee-shop-id-karzi
SHOPEE_SHOP_ID_WUWU=your-shopee-shop-id-wuwu
SHOPEE_SHOP_ID_ARMARINHOS_LIMA=your-shopee-shop-id-armarinhos-lima
SHOPEE_ACCESS_TOKEN_KARZI=your-shopee-access-token-karzi
SHOPEE_ACCESS_TOKEN_WUWU=your-shopee-access-token-wuwu
# Opcional: IP de saída fixo. Sem IP fixo (funções serverless da Vercel não
# têm um), a API da Shopee pode recusar chamada se a lista branca de IP
# estiver ativada no app. Deixe em branco para desligar o proxy a qualquer
# momento — sem precisar mudar código nenhum. Formato: http://usuario:senha@host:porta
SHOPEE_PROXY_URL=
SHOPEE_PROXY_URL_BACKUP=
SHOPEE_ACCESS_TOKEN_ARMARINHOS_LIMA=your-shopee-access-token-armarinhos-lima
# Credenciais do app "Elisa Lima - CRM" no Partner Center (Aplicativos e
# serviços > Desenvolvimento > Credenciais). App key/secret são do APP, um só
# par vale pra todas as marcas — assinam tanto as chamadas normais quanto a
# troca de code/refresh_token no OAuth (/api/tiktok/connect e
# /api/tiktok/callback, redirect_uri cadastrado no app:
# https://elisa-lima.vercel.app/api/tiktok/callback).
TIKTOK_APP_KEY=your-tiktok-app-key
TIKTOK_APP_SECRET=your-tiktok-app-secret
TIKTOK_SHOP_ID_KARZI=your-tiktok-shop-id-karzi
TIKTOK_SHOP_ID_WUWU=your-tiktok-shop-id-wuwu
TIKTOK_SHOP_ID_ARMARINHOS_LIMA=your-tiktok-shop-id-armarinhos-lima
TIKTOK_SHOP_CIPHER_KARZI=your-tiktok-shop-cipher-karzi
TIKTOK_SHOP_CIPHER_WUWU=your-tiktok-shop-cipher-wuwu
TIKTOK_SHOP_CIPHER_ARMARINHOS_LIMA=your-tiktok-shop-cipher-armarinhos-lima
# Fallback estático: só é lido quando não existe token persistido em
# canal_tokens para a marca (bootstrap/emergência) — mesma regra do
# ML_ACCESS_TOKEN_*. Depois de conectar via /api/tiktok/connect essas
# variáveis não são mais necessárias nem atualizadas automaticamente.
TIKTOK_ACCESS_TOKEN_KARZI=your-tiktok-access-token-karzi
TIKTOK_ACCESS_TOKEN_WUWU=your-tiktok-access-token-wuwu
TIKTOK_ACCESS_TOKEN_ARMARINHOS_LIMA=your-tiktok-access-token-armarinhos-lima

# Aplicação
NEXT_PUBLIC_APP_URL=https://elisa-lima.vercel.app

# PIN fixo de 6 dígitos exigido para acessar os dados de clientes
CLIENTES_PIN=000000

# WhatsApp (Z-API) — avisos internos para quem administra o CRM
# Kill switch: mantenha false até confirmar instância/token válidos
WHATSAPP_ADMIN_ALERTAS_ENABLED=false
ZAPI_INSTANCE_ID=your-zapi-instance-id
ZAPI_TOKEN=your-zapi-token
ZAPI_CLIENT_TOKEN=your-zapi-client-token
# Número do responsável que recebe os avisos, formato DDI+DDD+numero (ex: 5511999999999)
WHATSAPP_ADMIN_NUMERO=5511999999999

# E2E (somente ambiente de teste)
E2E_USER_EMAIL=e2e@example.invalid
E2E_USER_PASSWORD=replace-me
STAGING_E2E_BASE_URL=https://elisa-lima-git-dev-emanuelmaestre.vercel.app
STAGING_E2E_CONFIRMATION=create-temporary-user
